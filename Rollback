-- MAIN MENU
local function openMainMenu()
    keyFrame.Visible = false

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromOffset(220, 180)
    frame.Position = UDim2.new(0.5, -110, 0.5, -90)
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Parent = gui
    round(frame, 10)

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2.5
    stroke.Parent = frame

    -- TITLE
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -45, 0, 40)
    title.Position = UDim2.fromOffset(10, 0)
    title.BackgroundTransparency = 1
    title.Text = "Rollback by Wuang"
    title.TextColor3 = Color3.new(1, 1, 1)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 16
    title.Active = true
    title.Parent = frame

    -- CLOSE
    local close = makeButton(
        frame,
        "X",
        UDim2.new(1, -38, 0, 3),
        UDim2.fromOffset(35, 35),
        Color3.fromRGB(180, 45, 45)
    )

    -- ROLLBACK TOGGLE
    local toggle = makeButton(
        frame,
        "ROLLBACK: OFF",
        UDim2.fromOffset(15, 55),
        UDim2.new(1, -30, 0, 40),
        Color3.fromRGB(180, 45, 45)
    )

    toggle.MouseButton1Click:Connect(function()
        enabled = not enabled
        toggle.Text = enabled and "ROLLBACK: ON" or "ROLLBACK: OFF"
        toggle.BackgroundColor3 = enabled
            and Color3.fromRGB(40, 170, 80)
            or Color3.fromRGB(180, 45, 45)
    end)

    -- REJOIN SERVER
    local rejoin = makeButton(
        frame,
        "REJOIN SERVER",
        UDim2.fromOffset(15, 105),
        UDim2.new(1, -30, 0, 40),
        Color3.fromRGB(55, 100, 190)
    )

    rejoin.MouseButton1Click:Connect(function()
        player:Kick("Rollback cái con cặc mấy thằng ngu")
    end)

    -- DRAG MENU
    local dragging = false
    local dragStart
    local startPos

    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta = input.Position - dragStart

            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    close.MouseButton1Click:Connect(function()
        gui:Destroy()
    end)

    return stroke
end

-- VERIFY KEY
local unlocked = false
local mainStroke

check.MouseButton1Click:Connect(function()
    if unlocked then return end

    if keyInput.Text == KEY then
        unlocked = true
        status.Text = "Key Correct!"
        status.TextColor3 = Color3.fromRGB(50, 220, 100)

        task.wait(0.4)
        mainStroke = openMainMenu()
    else
        status.Text = "Invalid Key! Try Again."
        status.TextColor3 = Color3.fromRGB(255, 60, 60)
    end
end)

-- RGB ANIMATION
local hue = 0

RunService.RenderStepped:Connect(function(dt)
    if not gui.Parent then return end

    hue = (hue + dt * 0.3) % 1
    local rgb = Color3.fromHSV(hue, 1, 1)

    if keyFrame.Visible then
        keyStroke.Color = rgb
    end

    if mainStroke and mainStroke.Parent then
        mainStroke.Color = rgb
    end
end)

