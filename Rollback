
--// Rollback by Wuang - RGB Edition

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local enabled = false

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "RollbackByWuang"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

-- Main Frame
local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(220, 180)
frame.Position = UDim2.new(0.5, -110, 0.5, -90)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
frame.BorderSizePixel = 0
frame.Active = true
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = frame

-- RGB Border
local stroke = Instance.new("UIStroke")
stroke.Thickness = 2.5
stroke.Parent = frame

local hue = 0
local rgbConnection

rgbConnection = RunService.RenderStepped:Connect(function(dt)
    hue = (hue + dt * 0.3) % 1
    stroke.Color = Color3.fromHSV(hue, 1, 1)
end)

-- Title
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -45, 0, 40)
title.Position = UDim2.fromOffset(10, 0)
title.BackgroundTransparency = 1
title.Text = "Rollback by Wuang"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 16
title.Active = true
title.Parent = frame

-- Close Button
local close = Instance.new("TextButton")
close.Size = UDim2.fromOffset(35, 35)
close.Position = UDim2.new(1, -38, 0, 3)
close.Text = "X"
close.TextColor3 = Color3.new(1, 1, 1)
close.BackgroundColor3 = Color3.fromRGB(180, 45, 45)
close.Font = Enum.Font.GothamBold
close.TextSize = 16
close.Parent = frame

Instance.new("UICorner", close).CornerRadius = UDim.new(0, 7)

close.MouseButton1Click:Connect(function()
    if rgbConnection then
        rgbConnection:Disconnect()
    end
    gui:Destroy()
end)

-- Rollback Toggle
local toggle = Instance.new("TextButton")
toggle.Size = UDim2.new(1, -30, 0, 40)
toggle.Position = UDim2.fromOffset(15, 55)
toggle.BackgroundColor3 = Color3.fromRGB(180, 45, 45)
toggle.Text = "ROLLBACK: OFF"
toggle.TextColor3 = Color3.new(1, 1, 1)
toggle.Font = Enum.Font.GothamBold
toggle.TextSize = 14
toggle.Parent = frame

Instance.new("UICorner", toggle).CornerRadius = UDim.new(0, 7)

toggle.MouseButton1Click:Connect(function()
    enabled = not enabled

    toggle.Text = enabled and "ROLLBACK: ON" or "ROLLBACK: OFF"

    toggle.BackgroundColor3 = enabled
        and Color3.fromRGB(40, 170, 80)
        or Color3.fromRGB(180, 45, 45)
end)

-- Rejoin Button
local rejoin = Instance.new("TextButton")
rejoin.Size = UDim2.new(1, -30, 0, 40)
rejoin.Position = UDim2.fromOffset(15, 105)
rejoin.BackgroundColor3 = Color3.fromRGB(55, 100, 190)
rejoin.Text = "REJOIN SERVER"
rejoin.TextColor3 = Color3.new(1, 1, 1)
rejoin.Font = Enum.Font.GothamBold
rejoin.TextSize = 14
rejoin.Parent = frame

Instance.new("UICorner", rejoin).CornerRadius = UDim.new(0, 7)

rejoin.MouseButton1Click:Connect(function()
    TeleportService:TeleportToPlaceInstance(
        game.PlaceId,
        game.JobId,
        player
    )
end)

-- Drag Menu
local dragging = false
local dragStart
local startPos

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

print("Rollback by Wuang RGB Loaded!")
